---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const entries = (await getCollection("news")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<Layout
  title="更新履歴"
  description="更新履歴の一覧です。"
>
  <main class="page-shell">
    <header class="page-header">
      <h1 class="page-title">更新履歴</h1>
      <p class="page-lead">更新履歴です。</p>
    </header>

    {
      entries.length === 0 ? (
        <div class="empty-state">
          <div class="empty-icon">＊</div>
          <p class="empty-title">更新情報がありません。</p>
        </div>
      ) : (
        <section class="article-grid">
          {entries.map((entry) => (
            <a href={`/news/${entry.id}`} class="article-card">
              <div class="article-card-body">
                <h2 class="article-card-title">{entry.data.title}</h2>
                <time
                  class="article-card-date"
                  datetime={entry.data.date.toISOString()}
                >
                  {entry.data.date.toLocaleDateString("ja-JP", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })}
                </time>
              </div>
            </a>
          ))}
        </section>
      )
    }
  </main>
</Layout>
