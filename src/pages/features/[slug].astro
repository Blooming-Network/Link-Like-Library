---
import type { InferGetStaticPropsType } from "astro";
import { CollectionEntry, getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { render } from "astro:content";

type WithxmeetsItems = {
  withxmeets: CollectionEntry<"withxmeets">;
  items: string[],
}

export async function getStaticPaths() {
  const [withxmeets, entries] = await Promise.all([
    getCollection('withxmeets'),
    getCollection('features'),
  ]);


  // 特集を取得
  const featureKeys = withxmeets.reduce<string[]>((featureKeys, wm) => {
    if (wm.data.features) {
      for (let f of wm.data.features) {
        if (!featureKeys.includes(f.key)) {
          featureKeys.push(f.key);
        }
      }  
    }
    return featureKeys;
  }, []);

  // 特集の対象のWithMEETSを取得
  const getWithxmeetsAndItems = (key: string) => {
    let list: WithxmeetsItems[]= [];
    return withxmeets.reduce((accumulator, wm) => {
      if (!wm.data.features) return accumulator;

      const feature = wm.data.features.find(f => f.key === key);
      if (!feature) return accumulator;

      accumulator.push({
        withxmeets: wm,
        items: feature.items ?? []
      });

      return accumulator;
    }, list);
  }

  // 特集に対応する記事を取得
  const getEntry = (key: string) => {
    return entries.find((entry) => (
      entry.data.title == key
    ));
  }

  return featureKeys.map((key) => ({
    params:  {slug: key},
    props: {
      title: key,
      entry: getEntry(key),
      withxmeetsAndItems: getWithxmeetsAndItems(key)
    }
  }));

}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { title, entry, withxmeetsAndItems } = Astro.props as Props;
const Content = entry ? (await render(entry)).Content : null;


---

<Layout title={title} description={title}>
  <main class="page-shell">
    <nav
      class="breadcrumb"
      aria-label="パンくずリスト"
      style="margin-bottom: 16px;"
    >
      <a href="/">ホーム</a>
      <span class="breadcrumb-sep">/</span>
      <a href="/features">特集</a>
      <span class="breadcrumb-sep">/</span>
      <span>{title}</span>
    </nav>

    <article class="article-body">
      <h2>{title}</h2>
      <div>
        {Content && <Content />}
      </div>
      <div>
        <h2>関連するWith×MEETS</h2>
        <dl>
          {withxmeetsAndItems.map((wmitm) => (
            <dt>
              <a href={`/withxmeets/${wmitm.withxmeets.id}`}>{wmitm.withxmeets.data.title}</a>
            </dt>
            <dd>
              <ul>
                {wmitm.items.map((itm) => (<li>{itm}</li>))}
              </ul>
            </dd>
          ))}
        </dl>
      </div>
    </article>
  </main>
</Layout>
