---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const news = (await getCollection("news"))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);

const categories = [
  {
    href: "/activities",
    label: "活動記録",
    description: "ライブ・イベント・リリースなどの活動レポート",
    variant: "activities",
  },
  {
    href: "/withxmeets",
    label: "With x Meets",
    description: "メンバーとファンが交流するイベントの記録",
    variant: "withxmeets",
  },
  {
    href: "/calendar",
    label: "カレンダー",
    description: "With×MEETSをカレンダー形式で表示",
    variant: "calendar",
  },
  {
    href: "/members",
    label: "メンバー",
    description: "所属ユニット・期生ごとのメンバー紹介",
    variant: "members",
  },
  {
    href: "/features",
    label: "特集",
    description: "With×MEETSを特定の関連事項でまとめた記事",
    variant: "features",
  },
];
---

<Layout
  description="蓮ノ空女学院スクールアイドルクラブの活動・With x Meets・メンバーをまとめた、Link Like Library のホームです。"
>
  <main class="page-shell">
    <header class="page-header">
      <p class="eyebrow">ホーム</p>
      <h1 class="page-title">Link Like Library</h1>
    </header>

    <section class="home-section">
      <h2 class="home-section-title">Link Like Libraryとは</h2>
      <p class="home-section-text">
        蓮ノ空女学院スクールアイドルクラブの活動記録・With x
        Meets・メンバーを「蓮ノ空のこと好き好きクラブ」の視点から書き記すファンサイトです
      </p>
    </section>

    <section class="home-section">
      <h2 class="home-section-title">カテゴリ別記事一覧</h2>
      <div class="category-link-grid">
        {
          categories.map((c) => (
            <a href={c.href} class={`category-link category-link-${c.variant}`}>
              <div class="category-link-body">
                <p class="category-link-title">{c.label}</p>
                <p class="category-link-desc">{c.description}</p>
              </div>
              <span class="category-link-arrow" aria-hidden="true">
                →
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="home-section">
      <h2 class="home-section-title">更新履歴</h2>
      <div class="category-link-grid">
        {
          news.map((entry) => (
            <a href={`/news/${entry.id}`} class="category-link">
              <div class="category-link-body">
                <time
                  class="article-card-date"
                  datetime={entry.data.date.toISOString()}
                >
                  {entry.data.date.toLocaleDateString("ja-JP", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })}
                </time>
                <p class="category-link-desc">{entry.data.title}</p>
              </div>
            </a>
          ))
        }
        <a href="/news" class="category-link">
          <div class="category-link-body">
            <span class="article-card-date"> all </span>
            <p class="category-link-desc">更新履歴一覧</p>
          </div>
        </a>
      </div>
    </section>
  </main>
</Layout>
